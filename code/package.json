{
  "name": "nestjs-cache-proxy",
  "version": "0.0.0",
  "description": "Transparent, declarative caching for NestJS providers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrz38/nestjs-cache-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/jfrz38/nestjs-cache-proxy/issues"
  },
  "homepage": "https://github.com/jfrz38/nestjs-cache-proxy#readme",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "clean": "node ./scripts/clean.mjs",
    "format": "prettier --write ../README.md ../docs/compatibility.md ../docs/iterations/**/*.md ./**/*.{ts,mts,mjs,json}",
    "format:check": "prettier --check ../README.md ../docs/compatibility.md ../docs/iterations/**/*.md ./**/*.{ts,mts,mjs,json}",
    "lint": "eslint src tests scripts && pnpm run lint:markdown",
    "lint:markdown": "markdownlint-cli2 ../README.md ../docs/compatibility.md ../docs/iterations/**/*.md",
    "pack:check": "node ./scripts/pack-check.mjs",
    "postpack": "node ./scripts/cleanup-package-files.mjs",
    "prepack": "node ./scripts/prepare-package-files.mjs",
    "test": "vitest run",
    "test:backend": "vitest run tests/integration/memory/cache-backend.test.ts",
    "test:backend:redis": "node ./scripts/run-redis-contract.mjs",
    "test:backend:all": "pnpm run test:backend && pnpm run test:backend:redis",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestjs/cache-manager": "^3.0.0 || ^12.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "cache-manager": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jfrz38/eslint-plugin-clean-architecture-highlighter": "0.1.1",
    "@keyv/redis": "5.1.6",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "cache-manager": "7.2.9",
    "eslint": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "keyv": "5.6.0",
    "markdownlint-cli2": "0.20.0",
    "prettier": "3.9.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
